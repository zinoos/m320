@startuml Sequenzdiagramm_Waffenwechsel
' Use Case: "Krieger kaempft, wechselt die Waffe und kaempft erneut"
' (entspricht Main.main() aus V3 Serie B)
autonumber

actor Spieler
participant ":Main" as Main
participant "axt:AxtVerhalten" as Axt
participant "conan:Krieger" as Krieger
participant "dolch:DolchVerhalten" as Dolch

Spieler -> Main : main()
activate Main

Main -> Axt ** : new AxtVerhalten()
Main -> Krieger ** : new Krieger("Conan", axt)

Main -> Krieger : kaempfen()
activate Krieger
Krieger -> Krieger : getCharacterName()
Krieger -> Krieger : super.kaempfen()
activate Krieger #DDDDDD
Krieger -> Axt : verwendeWaffe()
activate Axt
Axt --> Krieger
deactivate Axt
deactivate Krieger
Krieger --> Main
deactivate Krieger

Main -> Dolch ** : new DolchVerhalten()
Main -> Krieger : setWaffe(dolch)
activate Krieger
Krieger --> Main
deactivate Krieger

Main -> Krieger : kaempfen()
activate Krieger
Krieger -> Krieger : super.kaempfen()
activate Krieger #DDDDDD
Krieger -> Dolch : verwendeWaffe()
activate Dolch
Dolch --> Krieger
deactivate Dolch
deactivate Krieger
Krieger --> Main
deactivate Krieger

deactivate Main
@enduml
