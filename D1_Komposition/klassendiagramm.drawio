        </mxCell>
        <mxCell id="legende" value="◆──  Komposition: das &quot;Teil&quot; kann nicht ohne das &quot;Ganze&quot; existieren&#10;         (kein Raum ohne Haus, keine Heizung ohne Raum)&#10;&#10;1 Haus hat 1..* Räume  |  1 Raum hat genau 1 Heizung&#10;&#10;-  vor Attribut = private     +  vor Methode = public" style="text;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="75" y="450" width="610" height="75" as="geometry" />
