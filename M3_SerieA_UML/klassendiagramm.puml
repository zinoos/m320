@startuml Klassendiagramm_V3
' Klassendiagramm zum Code aus V3 Serie B (Waffenverhalten)
skinparam classAttributeIconSize 0
hide empty members

abstract class Figur {
  - characterName : String
  - waffe : IWaffenVerhalten
  + Figur(characterName : String, waffe : IWaffenVerhalten)
  + getCharacterName() : String
  + setCharacterName(characterName : String) : void
  + getWaffe() : IWaffenVerhalten
  + setWaffe(waffe : IWaffenVerhalten) : void
  + laufen() : void
  + kaempfen() : void
}

class Krieger {
  + kaempfen() : void
}
class Magier {
  + kaempfen() : void
}
class Schurke {
  + kaempfen() : void
}

interface IWaffenVerhalten <<interface>> {
  + verwendeWaffe() : void
}

class AxtVerhalten {
  + verwendeWaffe() : void
}
class StabVerhalten {
  + verwendeWaffe() : void
}
class DolchVerhalten {
  + verwendeWaffe() : void
}

' IST-Beziehung (Vererbung): durchgezogene Linie, leeres Dreieck
Figur <|-- Krieger
Figur <|-- Magier
Figur <|-- Schurke

' Realisierung (Interface): gestrichelte Linie, leeres Dreieck
IWaffenVerhalten <|.. AxtVerhalten
IWaffenVerhalten <|.. StabVerhalten
IWaffenVerhalten <|.. DolchVerhalten

' HAT-Beziehung (Aggregation): leere Raute bei der Figur
Figur "0..*" o--> "1" IWaffenVerhalten : waffe

class Main {
  + {static} main(args : String[]) : void
}
' Abhaengigkeit: Main erzeugt Figuren und Waffen-Verhalten
Main ..> Figur : <<create>>
Main ..> IWaffenVerhalten : <<create>>
@enduml
